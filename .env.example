# Copy to .env and adjust as needed:  cp .env.example .env
# Used by docker-compose.yml. All values have sane defaults, so an empty .env
# (or no .env at all) still boots a working demo stack.

# --- PostgreSQL (shared ledger storage) ---
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
# Host port mapped to postgres:5432 (container talks to it as host "postgres").
POSTGRES_PORT=5433

# --- corren (ledger core + FaRl + sharia + guard + lens + wallets) ---
# Host port for the corren API. Keep 3068: the Horizon SPA calls the API at
# http://localhost:3068 from the browser (hardcoded in horizon/src/lib/ledger.js).
CORREN_PORT=3068
# Auth off = open demo. Set to true to require API keys / login.
CORREN_AUTH_ENABLED=false
# Admin bootstrap key, only used when CORREN_AUTH_ENABLED=true.
CORREN_ADMIN_KEY=

# --- horizon (dashboard SPA) ---
HORIZON_PORT=3078
